generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  // Scrypt password hash. Absent for Google-only and legacy accounts; not ownership evidence.
  passwordHash  String?
  // Legacy Match chat/link metadata is not authorization.
  // Only a website-approved MatchTelegramBinding grants Match access.
  linkCode         String?   @unique
  telegramChatId   String?
  telegramLinkedAt DateTime?
  // The customer's OWN Telegram bot (token stored encrypted). Empty = shared demo bot.
  botToken         String?
  botId            String?   @unique
  botUsername      String?
  // A background photo that was uploaded but not yet assigned to a match.
  pendingBackgroundPath String?
  createdAt     DateTime       @default(now())
  brands        Brand[]
  subscriptions Subscription[]
  selections    Selection[]
  favoriteTeams FavoriteTeam[]
  sessions      Session[]
  templates     Template[]
  newsSettings  NewsSettings?
  newsTemplates NewsTemplate[]
  authIdentities AuthIdentity[]
  matchPairingChallenges MatchPairingChallenge[]
  matchTelegramBinding MatchTelegramBinding?
}

// Google identities are bound by verified provider subject, never inferred from an email match.
model AuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  provider  String   @db.VarChar(16)
  subject   String   @db.VarChar(255)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
}

// A login. The browser holds the random token; only its SHA-256 is stored here.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The page the posts are made for: name shown on the image + optional background.
model Brand {
  id            String   @id @default(cuid())
  userId        String
  name          String
  backgroundUrl String?
  // Image uploaded from the dashboard (file on this computer, storage/backgrounds).
  backgroundPath String?
  // Look of the posts: which template, and whether the top corner shows the page name or the page logo.
  templateRef   String   @default("classic")
  brandMode     String   @default("text") // "text" or "logo"
  // Logo uploaded from the dashboard (file on this computer, storage/logos).
  logoPath      String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Which leagues a user wants posts for (API-Football league ids).
model Subscription {
  id        String   @id @default(cuid())
  userId    String
  leagueIds Int[]
  plan      String   @default("demo")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Shared match cache. One row per real match. Everything we learn from
// API-Football (status, score, events) is stored here ONCE and reused for every
// customer who picked the match. Rows are removed ~48h after kickoff.
// ---------------------------------------------------------------------------
model Match {
  fixtureId     Int       @id
  day           String // local day the match was listed under, e.g. "2026-10-09"
  leagueId      Int
  leagueName    String
  leagueLogo    String
  homeTeam      String
  awayTeam      String
  homeTeamId    Int?
  awayTeamId    Int?
  homeLogo      String
  awayLogo      String
  kickoff       DateTime
  statusShort   String    @default("NS")
  homeScore     Int?
  awayScore     Int?
  eventsJson    Json?
  finishedAt    DateTime?
  lastCheckedAt DateTime?
  elapsedMinutes Int?
  extraMinutes Int?
  // First eligible scheduled status observation, immutable; never reconstructed from kickoff.
  liveCheckpointAt DateTime?
  liveCheckpointJson Json?
  createdAt     DateTime  @default(now())
  selections    Selection[]

  @@index([day])
  @@index([kickoff])
}

// A customer's choice "make a post for this match", plus their background.
model Selection {
  id             String    @id @default(cuid())
  userId         String
  fixtureId      Int
  status         String    @default("SELECTED") // SELECTED, SENDING, COMPLETED, FAILED, DESELECTED (retained receipts)
  backgroundPath String?
  attempts       Int       @default(0)
  lastError      String?
  sentAt         DateTime?
  selectedAt     DateTime @default(now())
  liveStatus     String @default("PENDING") // PENDING, SENDING, SENT, FAILED, UNCERTAIN
  liveAttempts   Int @default(0)
  liveUpdatedAt  DateTime?
  liveLastError  String?
  liveSentAt     DateTime?
  // Durable send fences: never retry an ambiguous Telegram dispatch after a restart.
  liveDispatchAt DateTime?
  finalDispatchAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match          Match     @relation(fields: [fixtureId], references: [fixtureId], onDelete: Cascade)

  @@unique([userId, fixtureId])
  @@index([status])
}

// Which days' match lists were already downloaded (so the list costs 1 request per day).
model FixtureDay {
  date      String   @id
  fetchedAt DateTime @default(now())
}

// Counts API-Football requests per day, so we never go over the free limit.
model ApiUsage {
  day   String @id
  count Int    @default(0)
}

// Clubs a customer can follow (filled by "npm run seed:teams" and by the daily match lists).
model Team {
  id       Int    @id // API-Football team id
  name     String
  logo     String
  leagueId Int

  @@index([leagueId])
}

// "Show me every match of this club in /matches", even if its league is not selected.
model FavoriteTeam {
  id     String @id @default(cuid())
  userId String
  teamId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

// A template made by the customer: pasted HTML, or built with the options form (config keeps those options).
// html is checked by render/template-check.js before it is stored and again before every render.
model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  html      String
  config    Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


// News is fully independent of Match (including its Telegram credentials).
model NewsSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  botToken String?
  botId String? @unique
  botUsername String?
  telegramChatId String?
  defaultTemplateRef String @default("single")
  // Single-use linking token; the browser receives the token, the database only its hash.
  linkCodeHash String?
  linkExpiresAt DateTime?
  // File IDs and conversation metadata, never image bytes or Telegram credentials.
  pending Json?
  lastUpdateId Int?
}

model NewsTemplate {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  layout String
  config Json
  createdAt DateTime @default(now())
  @@index([userId])
}

// Pending requests grant no authority. Only their hashes are stored.
model MatchPairingChallenge {
  id String @id @default(cuid())
  userId String
  botId String
  connectionHash String @db.Char(64)
  telegramUserId String
  chatId String
  codeHash String @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, botId, telegramUserId])
  @@index([userId, expiresAt])
}

// Website-approved recipient, independent of the untrusted legacy User.telegramChatId.
model MatchTelegramBinding {
  userId String @id
  botId String @unique
  telegramUserId String
  chatId String
  authorizedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
