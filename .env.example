# Copy this file to ".env" and paste your Neon connection string.
# Neon dashboard -> your project -> Connect -> copy the "postgresql://..." string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Telegram bot for customers (create a NEW bot with @BotFather, not the one n8n uses).
TELEGRAM_BOT_TOKEN="123456:ABC-your-token"
# Bot username WITHOUT the @ sign, e.g. FinalWhistleDemoBot
TELEGRAM_BOT_USERNAME="YourBotUsername"
