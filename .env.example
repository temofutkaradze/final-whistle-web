# Copy this file to ".env" and paste your Neon connection string.
# Neon dashboard -> your project -> Connect -> copy the "postgresql://..." string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional "Continue with Google" (free). Leave empty to hide the button. Setup steps are in README.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: the public address of the site (e.g. your domain later). Empty = the address you open in the browser.
APP_URL=""

# There is no shared bot: every customer connects their OWN bot (token from @BotFather) on the dashboard.
# TELEGRAM_BOT_TOKEN and TELEGRAM_BOT_USERNAME are no longer used and can be deleted from your .env.

# Render server (render/render-server.js, started with "npm run render").
# Optional: the port it listens on, and the address the site and worker use to reach it (defaults shown).
# RENDER_PORT="4500"
# RENDER_SERVER_URL="http://127.0.0.1:4500/render"

# API-Football key (dashboard.api-football.com). Used by the bot and the worker.
API_FOOTBALL_KEY="your-api-football-key"

# Optional testing: add extra league ids to today's list (307 = Saudi Pro League). Remove afterwards.
# EXTRA_LEAGUES="307"
# Optional: time zone for "today" and kickoff times (default Asia/Tbilisi).
# DISPLAY_TZ="Asia/Tbilisi"

# Secret used to encrypt customers' bot tokens in the database. Any long random text (16+ characters).
# Create one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Keep it safe. If you lose or change it, saved bot tokens cannot be read and customers must reconnect.
APP_SECRET="paste-a-long-random-text-here"

# Dedicated News renderer authentication (generate a random 64-character hex value)
NEWS_RENDER_SECRET=""
