{
  "name": "final-whistle-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "bot": "node --env-file=.env scripts/bot.mjs",
    "postinstall": "prisma generate",
    "worker": "node --env-file=.env scripts/worker.mjs",
    "seed:teams": "node --env-file=.env scripts/seed-teams.mjs",
    "render": "node --env-file=.env render/render-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.0",
    "vitest": "^5.1.0"
  }
}
